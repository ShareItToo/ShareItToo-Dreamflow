[Unit]
Description=ShareItToo production health check
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=shareittoo-alert@%n.service

[Service]
Type=oneshot
ExecStart=/docker/shareittoo/backend/ops/healthcheck.sh
Environment=ALERT_COOLDOWN_SECONDS=86400
ExecStartPost=-/docker/shareittoo/backend/ops/alert.sh %n recovery
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
