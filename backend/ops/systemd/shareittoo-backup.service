[Unit]
Description=ShareItToo daily database and upload backup
Requires=docker.service
After=docker.service
OnFailure=shareittoo-alert@%n.service

[Service]
Type=oneshot
ExecStart=/docker/shareittoo/backend/ops/backup.sh
Environment=ALERT_COOLDOWN_SECONDS=86400
# Recovery runs only at the script's completed-work branch, never on lock-busy skip.
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
