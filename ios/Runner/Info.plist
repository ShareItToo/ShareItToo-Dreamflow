<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ShareItToo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ShareItToo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<!-- FCM and Crashlytics stay available but require separate in-app opt-in. -->
	<key>FirebaseMessagingAutoInitEnabled</key>
	<false/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<!-- Real public Meta values are supplied in the release configuration. -->
	<key>FacebookAppID</key>
	<string>$(SIT_FACEBOOK_APP_ID)</string>
	<key>FacebookClientToken</key>
	<string>$(SIT_FACEBOOK_CLIENT_TOKEN)</string>
	<key>FacebookDisplayName</key>
	<string>ShareItToo</string>
	<key>FacebookAutoLogAppEventsEnabled</key>
	<false/>
	<key>FacebookAdvertiserIDCollectionEnabled</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.shareittoo.app.links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>shareittoo</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.shareittoo.app.facebook</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb$(SIT_FACEBOOK_APP_ID)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.shareittoo.app.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(SIT_GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<!-- Photo and camera permissions -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Fotos auswählen, um deine Anzeige attraktiver zu machen.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Wir speichern auf Wunsch Übergabe- und Rückgabefotos zusätzlich in deiner Galerie.</string>
	<key>NSCameraUsageDescription</key>
	<string>Fotos aufnehmen, um deine Anzeige zu erstellen.</string>
	<!-- Location permission for automatic city selection -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wir verwenden deinen Standort, um automatisch die nächstgelegene Stadt zu wählen.</string>
</dict>
</plist>
