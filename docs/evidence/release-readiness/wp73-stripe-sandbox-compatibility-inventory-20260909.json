  "blockingFinding": {
    "id": "stripe-dispute-paid-transfer-recovery",
    "severity": "P0-payment-integrity-before-provider-traffic",
    "proven": true,
    "basis": "The refund workflow reverses an existing owner transfer, but the charge.dispute event workflow only records the dispute and ledger impact and blocks future payout. It has no provider transfer reversal or durable recovery state for a transfer that was already paid before the dispute.",
    "alreadyPaidTransferAutomaticallyRecoveredOnDispute": false,
    "futurePayoutBlockedOnDispute": true,
    "chargebackLedgerRecorded": true,
    "retryableReversalRecoveryStatePresent": false,
    "providerTrafficAllowedBeforeCorrection": false,
    "requiredClosure": "Implement idempotent dispute-linked reversal of the recoverable paid owner share, explicit insufficient-balance and uncertain-result recovery, immutable ledger binding, needsReview escalation, and deterministic won/lost/funds-reinstated tests before any Stripe sandbox money scenario."
  },
  "ownerGate": {
    "id": "WP73_STRIPE_READONLY_REAUTH_REQUIRED",
    "required": true,
    "exactAction": "Reauthenticate the official Stripe connector and select only the isolated ShareItToo sandbox in test mode. Do not enable live mode and do not create API keys, webhook destinations, products, prices, customers, connected accounts, payments, refunds or transfers.",
    "afterActionReadOnlyChecks": [
      "confirm exact sandbox context and test mode",
      "confirm country and settlement currency",
      "inspect platform business-profile and terms requirement names without retaining personal values",
      "confirm charges, payouts and capability status",
      "count existing connected accounts without creating one",
      "count and classify existing event destinations without creating one",
      "confirm no competing provider configuration"
    ],
    "doesNotAuthorizeCredentials": true,
    "doesNotAuthorizeProviderTraffic": true,
    "doesNotAuthorizeLiveMode": true,
    "doesNotAuthorizeBillingOrMoney": true
  },
