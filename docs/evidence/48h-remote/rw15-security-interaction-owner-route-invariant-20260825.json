  "findings": [
    {
      "id": "RW15-P0-LOGOUT-ALL-STALE-CONFIRMATION-001",
      "state": "resolved-and-tested",
      "resolution": "A red-first widget test observed one Account A logout-all call after B activated; the exact owner is now captured before the dialog and the A route is dismissed on the epoch change."
    },
    {
      "id": "RW15-P0-LOGOUT-ALL-OPEN-RESULT-002",
      "state": "resolved-and-tested",
      "resolution": "An already rendered Account A logout-all result is now removed by exact route identity when B activates."
    },
    {
      "id": "RW15-P0-GLOBAL-NAVIGATOR-POP-RACE-003",
      "state": "resolved-and-tested",
      "resolution": "TrackedDialogRouteHandle removes only its owned route; a newer B-owned dialog above the A route remains visible in the deterministic widget test."
    },
    {
      "id": "RW15-P0-STATUS-ONLY-REJECTION-004",
      "state": "resolved-and-tested",
      "resolution": "Definite rejection now requires an exact status and operation error code; 408, unstructured or foreign 4xx, invalid responses and 5xx remain unknown."
    },
    {
      "id": "RW15-P0-REPOSITORY-SECURITY-ACTION-INVENTORY-005",
      "state": "inventory-complete-follow-up-required",
      "resolution": "Every discovered account/session/credential call site is pinned in the validator; reachable open P0/P1 flows keep BUILD_READY closed and are prioritized after RW15."
    }
