  "findings": [
    {
      "id": "RW20-P0-LISTING-SUCCESSOR-TOKEN-RACE-001",
      "state": "resolved-and-tested",
      "resolution": "Listing writes carry the exact token-free owner through coordinator, data layer and repository, so Account A payloads cannot acquire Account B credentials."
    },
    {
      "id": "RW20-P0-DELAYED-LISTING-RESULT-UNDER-SUCCESSOR-002",
      "state": "resolved-and-tested",
      "resolution": "Result surfaces and navigation revalidate exact principal and action epoch; delayed Account A results remain invisible under Account B."
    },
    {
      "id": "RW20-P1-LISTING-RESULT-TRUTH-COLLAPSE-003",
      "state": "resolved-and-tested",
      "resolution": "Rejected, remotely accepted with local failure, unknown and principal-changed results remain typed and are handled before generic catches."
    },
    {
      "id": "RW20-P0-LOCAL-CATALOG-MID-WRITE-TRANSITION-004",
      "state": "resolved-and-tested",
      "resolution": "Owner verification brackets persistence and any interrupted local catalog commit is rolled back before the failure is surfaced."
    },
    {
      "id": "RW20-P1-MEDIA-ASSISTANT-AWAIT-RACE-005",
      "state": "resolved-and-tested",
      "resolution": "Picker, byte read, upload, Blue Ocean and supply-enrichment awaits revalidate their captured listing owner."
    },
    {
      "id": "RW20-P0-LISTING-ROUTE-GLOBAL-POP-RACE-006",
      "state": "resolved-and-tested",
      "resolution": "Dialogs and pushed pages are removed by exact owned route identity and never by globally popping a successor route."
    },
    {
      "id": "RW20-P1-CROSS-OWNER-CREATE-EVENT-007",
      "state": "resolved-and-tested",
      "resolution": "The transient created-listing event is set and consumed only for the exact session owner and is cleared on mismatch."
    },
    {
      "id": "RW20-P0-DIRECT-SCREEN-LISTING-WRITE-BYPASS-008",
      "state": "resolved-and-tested",
      "resolution": "Every repository-owned listing mutation surface uses the owner-bound coordinator; permanent inventory requires zero legacy DataService listing write call sites in UI screens."
    }
  ],
