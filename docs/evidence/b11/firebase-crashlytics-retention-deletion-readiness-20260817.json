  "officialSources": [
    {
      "purpose": "retention",
      "url": "https://firebase.google.com/support/privacy/",
      "finding": "Firebase Crashlytics retains crash stack traces, extracted minidump data and associated Crashlytics or Firebase installation identifiers for 90 days before starting removal from live and backup systems."
    },
    {
      "purpose": "opt-in-control",
      "url": "https://firebase.google.com/docs/crashlytics/android/customize-crash-reports",
      "finding": "Firebase documents opt-in reporting by disabling automatic collection and enabling it only after a user choice. Disabling collection can leave unsent reports on the device until they are explicitly deleted or later sent."
    },
    {
      "purpose": "stored-report-deletion-control",
      "url": "https://firebase.google.com/docs/reference/crashlytics/rest/v1alpha/projects.apps.users/deleteCrashReports",
      "finding": "Firebase provides a REST operation that queues permanent deletion of crash reports associated with a configured Crashlytics user ID, typically within 24 hours. SIT does not yet prove the required subject correlation, authorization or operational invocation."
    },
    {
      "purpose": "processor-role-and-transfer-framework",
      "url": "https://firebase.google.com/terms/data-processing-terms/",
      "finding": "The Firebase Data Processing and Security Terms cover Crashlytics and describe Google as processor for Customer Personal Data under European data protection law. Account acceptance and SIT approval are not proven by reviewing this public page."
    }
  ],
