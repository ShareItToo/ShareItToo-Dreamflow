  "officialSources": [
    {
      "purpose": "retention",
      "url": "https://firebase.google.com/support/privacy/",
      "finding": "Firebase Cloud Messaging uses Firebase installation IDs for delivery. Firebase retains an installation ID until the customer requests deletion; after the request, related data is removed from live and backup systems within 180 days."
    },
    {
      "purpose": "deletion-control",
      "url": "https://firebase.google.com/docs/projects/manage-installations",
      "finding": "The Firebase Installations client API can delete the current installation ID and data tied to it. Unless every ID-generating Firebase service remains disabled, a later use can create a new unrelated installation ID."
    },
    {
      "purpose": "processor-role-and-transfer-framework",
      "url": "https://firebase.google.com/terms/data-processing-terms/",
      "finding": "The Firebase Data Processing and Security Terms describe Google as processor for Customer Personal Data under European data protection law and identify the applicable subprocessor and transfer framework. Account acceptance and SIT approval are not proven by reviewing this public page."
    }
  ],
